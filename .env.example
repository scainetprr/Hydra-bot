# ===== CÓMO LLENAR ESTO (léeme, en serio) =====
# 1. NO subas el archivo ".env" a GitHub. Solo esta plantilla ".env.example".
# 2. Copia esta plantilla a un archivo llamado ".env" y pega tus valores ahí.
#    - En tu PC:  Copy-Item .env.example .env   (PowerShell)  o  cp .env.example .env
#    - En tu hosting: pega estos mismos valores en "Environment / Variables".

# Contraseña secreta del bot (Discord Developers → Bot → Reset Token)
TOKEN=pega_aqui_tu_token_sin_comillas_ni_espacios

# Clic derecho en tu servidor con Modo Desarrollador → Copiar ID
GUILD_ID=pega_aqui_id_del_servidor

# Clic derecho en el rol "Verificado" → Copiar ID
ROLE_VERIFIED=pega_aqui_id_rango_verificado

# Clic derecho en el rol "No Verificado" → Copiar ID
ROLE_UNVERIFIED=pega_aqui_id_rango_no_verificado

# Clic derecho en el canal #verificacion → Copiar ID
CHANNEL_VERIFICATION=pega_aqui_id_del_canal
